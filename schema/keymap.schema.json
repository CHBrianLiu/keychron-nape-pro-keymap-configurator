  "title": "Nape Pro keymap source v2",
  "description": "Eight complete visible layers plus preserved Launcher data. See README.md for semantic build checks.",
  "type": "object",
  "properties": {
    "version": {
      "const": 2
    },
    "device": {
      "const": "nape-pro"
    },
    "layers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/layer"
      },
      "minItems": 8,
      "maxItems": 8
    },
    "combinations": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 29
              },
              "timeout": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              },
              "buttons": {
                "type": "array",
                "items": {
                  "enum": [
                    "03",
                    "04",
                    "01",
                    "02",
                    "m1",
                    "m2"
                  ]
                },
                "minItems": 2,
                "maxItems": 4,
                "uniqueItems": true
              },
              "layer": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              },
              "raw_layer": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "tap": {
                "$ref": "#/$defs/action"
              },
              "hold": {
                "$ref": "#/$defs/action"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "index",
              "timeout",
              "buttons",
              "tap",
              "hold"
            ],
            "additionalProperties": false,
            "oneOf": [
              {
                "required": [
                  "layer"
                ]
              },
              {
                "required": [
                  "raw_layer"
                ]
              }
            ]
          },
          {
            "type": "object",
            "properties": {
              "raw": {
                "type": "object",
                "properties": {
                  "index": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 29
                  },
                  "timeout": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  },
                  "layer": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  },
                  "cols": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 255
                  },
                  "tap": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  },
                  "held": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  }
