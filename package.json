{
  "name": "keychron-nape-pro-configurator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Build Keychron Launcher keymaps from an authoritative YAML source",
  "engines": { "node": ">=22" },
  "scripts": {
    "validate": "ajv validate --spec=draft2020 -s schema/keymap.schema.json -d keymap.yaml --all-errors",
    "build": "node src/build.js",
    "test": "node --test"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "ajv-cli": "5.0.0"
  },
  "overrides": {
    "ajv-cli": {
      "fast-json-patch": "3.1.1",
      "glob": "14.0.3"
    }
  }
}
